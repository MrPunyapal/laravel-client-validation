{
  "name": "mrpunyapal/client-validation-filament",
  "version": "0.1.1",
  "description": "Filament integration for Laravel Client Validation: native-field macros, render-time x-validate attributes, and custom validation messages/attributes forwarded to the browser.",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Punyapal Shah",
      "email": "mrpunyapal@gmail.com"
    }
  ],
  "require": {
    "php": "^8.3",
    "filament/filament": "^5.0",
    "mrpunyapal/laravel-client-validation": "^0.1.0",
    "spatie/laravel-package-tools": "^1.16"
  },
  "require-dev": {
    "orchestra/testbench": "^10.0|^11.0",
    "pestphp/pest": "^3.0",
    "pestphp/pest-plugin-laravel": "^3.0"
  },
  "autoload": {
    "psr-4": {
      "MrPunyapal\\ClientValidation\\Filament\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "MrPunyapal\\ClientValidation\\Filament\\ClientValidationFilamentServiceProvider"
      ]
    }
  },
  "repositories": [
    {
      "type": "path",
      "url": "../../..",
      "options": {
        "symlink": true
      }
    }
  ],
  "scripts": {
    "test": "vendor/bin/pest"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "php-http/discovery": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
  }
}